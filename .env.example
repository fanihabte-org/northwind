# Absolute host path used only for durable Bulk Query CSV result artifacts.
# Copy to .env and replace "your-user" before starting Docker Compose.
FAKEFORCE_EXPORTS_DIR=/Users/your-user/data_forge/exports

# Business date immediately before the first daily increment. Required by the
# simulator service; never change it after the simulator initializes its state.
SIMULATION_BASELINE_DATE=2026-07-24
SIMULATION_SEED=42
# Simulator DuckDB safety limits. Its temporary spill files live in state/.
SIMULATION_DUCKDB_MEMORY_LIMIT=512MB
SIMULATION_DUCKDB_MAX_TEMP_SIZE=20GB
SIMULATION_DUCKDB_THREADS=1
